{
  "manifest_version": 3,
  "name": "플래나이(PLANAI)",
  "description": "쪽지로 쏟아지는 업무 일정과 메모를 AI가 정리·검색·브리핑하는 지능형 업무 플래너입니다.",
  "version": "1.0.5",
  "action": {
    "default_title": "플래나이(PLANAI) 열기",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  }
}
