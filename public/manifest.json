{
  "manifest_version": 3,
  "name": "업무 일정관리",
  "description": "달력, 프로젝트, 일정 종류와 AI 입력으로 업무 일정을 관리하는 확장 프로그램입니다.",
  "version": "0.1.0",
  "action": {
    "default_title": "업무 일정관리 열기"
  },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  }
}
