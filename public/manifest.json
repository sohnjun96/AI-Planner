{
  "manifest_version": 3,
  "name": "일정아이",
  "description": "달력, 프로젝트, 일정 종류와 AI 입력으로 일정을 관리하는 확장 프로그램입니다.",
  "version": "1.0.0",
  "action": {
    "default_title": "일정아이 열기"
  },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  }
}
